#!/bin/bash
# acme-please deploy hook for {{ _acme_please_cert.name }} — runs on
# every successful issuance/renewal (certbot deploy hook contract:
# RENEWED_LINEAGE points at the live directory).
set -euo pipefail
LINEAGE="${RENEWED_LINEAGE:-/etc/letsencrypt/live/{{ _acme_please_cert.name }}}"

install -m {{ _acme_please_deploy.mode_cert | default('0644') }} \
  -o {{ _acme_please_deploy.owner | default('root') }} -g {{ _acme_please_deploy.group | default('root') }} \
  "$LINEAGE/cert.pem" '{{ _acme_please_deploy.cert }}'
install -m {{ _acme_please_deploy.mode_key | default('0600') }} \
  -o {{ _acme_please_deploy.owner | default('root') }} -g {{ _acme_please_deploy.group | default('root') }} \
  "$LINEAGE/privkey.pem" '{{ _acme_please_deploy.key }}'
install -m {{ _acme_please_deploy.mode_cert | default('0644') }} \
  -o {{ _acme_please_deploy.owner | default('root') }} -g {{ _acme_please_deploy.group | default('root') }} \
  "$LINEAGE/chain.pem" '{{ _acme_please_deploy.chain }}'

{% if _acme_please_selinux %}
# key outside the standard dirs on an SELinux host: keep the cert_t
# label the access-profiles TLS doc requires
command -v restorecon >/dev/null && restorecon -F '{{ _acme_please_deploy.key }}' '{{ _acme_please_deploy.cert }}' || true
{% endif %}

{% if _acme_please_deploy.pkcs12 | default('') | length > 0 %}
# the Tomcat rebuild — PEM into a PKCS12 keystore
openssl pkcs12 -export -in "$LINEAGE/cert.pem" -inkey "$LINEAGE/privkey.pem" \
  -certfile "$LINEAGE/chain.pem" -out '{{ _acme_please_deploy.pkcs12 }}' \
  -passout 'pass:{{ _acme_please_deploy.pkcs12_passphrase | default("") }}'
chmod 0640 '{{ _acme_please_deploy.pkcs12 }}'
chown {{ _acme_please_deploy.owner | default('root') }}:{{ _acme_please_deploy.group | default('root') }} '{{ _acme_please_deploy.pkcs12 }}'
{% endif %}

{% if _acme_please_deploy.combined | default('') | length > 0 %}
# HAProxy (and stunnel, and Postfix) want ONE file: the leaf, its
# intermediates and the private key concatenated. Order is fullchain then
# key, which is what every HAProxy example uses.
#
# umask 077 before the redirect, not chmod after it. `cat a b > dest`
# creates dest with the ambient umask FIRST and writes the key into it, so a
# chmod afterwards closes a window that has already been open -- briefly
# world-readable, on a file that is mostly private key.
(
  umask 077
  cat "$LINEAGE/fullchain.pem" "$LINEAGE/privkey.pem" > '{{ _acme_please_deploy.combined }}.tmp'
)
chown {{ _acme_please_deploy.owner | default('root') }}:{{ _acme_please_deploy.combined_group | default(_acme_please_deploy.group | default('root')) }} '{{ _acme_please_deploy.combined }}.tmp'
chmod {{ _acme_please_deploy.combined_mode | default('0600') }} '{{ _acme_please_deploy.combined }}.tmp'
# Rename last: HAProxy may be reading the live file, and a rename is atomic
# where a partial write is a certificate that parses as garbage.
mv -f '{{ _acme_please_deploy.combined }}.tmp' '{{ _acme_please_deploy.combined }}'
{% if _acme_please_selinux %}
command -v restorecon >/dev/null && restorecon -F '{{ _acme_please_deploy.combined }}' || true
{% endif %}
{% endif %}

date -u +%FT%TZ >> /var/lib/acme-please/{{ _acme_please_cert.name }}.deployed

{% if _acme_please_deploy.reload | default('') | length > 0 %}
{{ _acme_please_deploy.reload }}
{% endif %}
